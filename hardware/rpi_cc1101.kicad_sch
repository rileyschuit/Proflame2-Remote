(text "Put C1 and C2 at the CC1101 VCC and GND pins." (exclude_from_sim no) (at 39.37 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "3420908e-cd02-502c-b7cc-874e76ee3622"))
(text "ANT: 315 MHz antenna, or a 23.8 cm wire on modules with a solder pad." (exclude_from_sim no) (at 39.37 119.38 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ef3ec458-1a7d-5389-bc2b-1d384709b885"))
(text "Power from pin 17 (3.3 V), never pin 2 or 4 (5 V). Check the pin order against your module's silkscreen." (exclude_from_sim no) (at 39.37 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "3db0e3c7-8333-5c95-82b5-cbd8f0b420fa"))
(text "Enable SPI: dtparam=spi=on in /boot/firmware/config.txt. CSN uses CE0 (/dev/spidev0.0)." (exclude_from_sim no) (at 39.37 129.54 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5ebfef55-c6fc-513d-9942-a80c2ea875f2"))
